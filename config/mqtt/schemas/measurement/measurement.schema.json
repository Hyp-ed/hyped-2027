{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file:///schemas/measurement/measurement.schema.json",
  "title": "Measurement",
  "description": "A sensor reading from the pod. The measurement ID is in the topic (hyped/{podId}/measurement/{measurementId}), and it decides which payload shape applies.",
  "type": "array",
  "prefixItems": [
    {
      "title": "Time of data",
      "description": "the time at which the data was acquired",
      "$ref": "#/$defs/uint"
    },
    {
      "anyOf": [
        {
          "title": "HVAL Status",
          "description": "Payload for measurementId 100. No CDDL definition yet."
        },
        {
          "title": "IMDStatus",
          "description": "Payload for measurementId 300.",
          "$ref": "#/$defs/imdStatus"
        },
        {
          "title": "HV BMS Status",
          "description": "Payload for measurementId 400.",
          "$ref": "#/$defs/bmsStatus"
        },
        {
          "title": "LV BMS Status",
          "description": "Payload for measurementId 500.",
          "$ref": "#/$defs/bmsStatus"
        },
        {
          "title": "TempSensors",
          "description": "Payload for measurementId 601.",
          "$ref": "#/$defs/tempSensors"
        },
        {
          "title": "PressureSensors",
          "description": "Payload for measurementId 602.",
          "$ref": "#/$defs/pressureSensors"
        },
        {
          "title": "MotorControllerCmd",
          "description": "Payload for measurementId 603.",
          "$ref": "#/$defs/motorControllerCmd"
        }
      ]
    }
  ],
  "items": false,
  "minItems": 2,
  "$defs": {
    "hvalStatus": {
      "title": "array",
      "prefixItems": [
        {
          "title": "measurement",
          "description": "measurement of a current",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "is_SDC_open",
          "description": "SDC status",
          "type": "boolean"
        }
      ],
      "items": false,
      "minItems": 5
    },
    "imdStatus": {
      "type": "array",
      "prefixItems": [
        {
          "title": "corrected",
          "$ref": "#/$defs/uint"
        },
        {
          "title": "status",
          "$ref": "#/$defs/uint"
        },
        {
          "title": "measurement_counter",
          "$ref": "#/$defs/uint"
        },
        {
          "title": "warnings_and_alarms",
          "$ref": "#/$defs/uint"
        },
        {
          "title": "device_activity",
          "$ref": "#/$defs/uint"
        }
      ],
      "items": false,
      "minItems": 5
    },
    "bmsStatus": {
      "type": "array",
      "prefixItems": [
        {
          "title": "voltage",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "current",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "max_cell_mv",
          "$ref": "#/$defs/uint"
        },
        {
          "title": "min_cell_mv",
          "$ref": "#/$defs/uint"
        },
        {
          "title": "temperatures_c",
          "type": "array",
          "prefixItems": [
            {
              "title": "internal",
              "type": "integer"
            },
            {
              "title": "external1",
              "type": "integer"
            },
            {
              "title": "external2",
              "type": "integer"
            }
          ],
          "items": false,
          "minItems": 3
        },
        {
          "title": "cell_voltages_mv",
          "type": "array",
          "items": {
            "$ref": "#/$defs/uint"
          },
          "minItems": 16,
          "maxItems": 16
        }
      ],
      "items": false,
      "minItems": 6
    },
    "tempSensors": {
      "type": "array",
      "prefixItems": [
        {
          "title": "sns1",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns2",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns3",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns4",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns5",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns6",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns7",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns8",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns9",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns10",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns11",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns12",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns13",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns14",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns15",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns16",
          "$ref": "#/$defs/float32"
        }
      ],
      "items": false,
      "minItems": 24
    },
    "pressureSensors": {
      "type": "array",
      "prefixItems": [
        {
          "title": "sns1",
          "$ref": "#/$defs/float32"
        },
        {
          "title": "sns2",
          "$ref": "#/$defs/float32"
        }
      ],
      "items": false,
      "minItems": 3
    },
    "motorControllerCmd": {
      "$ref": "#/$defs/uint"
    },
    "uint": {
      "$anchor": "uint",
      "description": "Unsigned integer (CBOR major type 0).",
      "type": "integer",
      "minimum": 0
    },
    "uint16": {
      "$anchor": "uint16",
      "description": "Unsigned 16-bit integer: 0 to 65535.",
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "uint32": {
      "$anchor": "uint32",
      "description": "Unsigned 32-bit integer: 0 to 4294967295.",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "nint": {
      "$anchor": "nint",
      "description": "Negative integer (CBOR major type 1): -1 or less.",
      "type": "integer",
      "maximum": -1
    },
    "nint16": {
      "$anchor": "nint16",
      "description": "Negative integer whose CBOR argument fits in 16 bits: -65536 to -1.",
      "type": "integer",
      "minimum": -65536,
      "maximum": -1
    },
    "nint32": {
      "$anchor": "nint32",
      "description": "Negative integer whose CBOR argument fits in 32 bits: -4294967296 to -1.",
      "type": "integer",
      "minimum": -4294967296,
      "maximum": -1
    },
    "float32": {
      "$anchor": "float32",
      "description": "Number within IEEE 754 single-precision range. Precision is not enforced.",
      "type": "number",
      "minimum": -3.4028234663852886e+38,
      "maximum": 3.4028234663852886e+38
    },
    "bytes": {
      "$anchor": "bytes",
      "description": "Byte array as a list of integers 0 to 255.",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  }
}
