{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file:///schemas/register/response.schema.json",
  "title": "Registration Response",
  "description": "The base station's response. Encoded as the status code.",

  "anyOf": [
    {
      "const": 0,
